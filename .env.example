# --- Base de datos ---
DATABASE_URL="file:./prisma/dev.db"

# --- Servidor ---
PORT=3000
HOST=0.0.0.0

# --- SNMP ---
# Community por defecto para consultas v1/v2c (se sobrescribe por impresora).
SNMP_DEFAULT_COMMUNITY=public
SNMP_DEFAULT_VERSION=v2c
SNMP_TIMEOUT_MS=3000
SNMP_RETRIES=1

# Modo mock: usa fixtures locales en vez de impresoras reales (dev sin hardware).
# Pon SNMP_MOCK=true para probar el slice vertical sin una RICOH en la red.
SNMP_MOCK=false

# --- Polling Engine (Fase 4, sección 16) ---
# Interruptor general del scheduler de polling.
POLLING_ENABLED=true
# Intervalos por tipo de dato, en milisegundos (defaults recomendados sección 16).
# Status / Online: 30-60 s
POLL_STATUS_MS=45000
# Errores: 1-2 min
POLL_ERRORS_MS=90000
# Consumibles: 5 min
POLL_SUPPLIES_MS=300000
# Bandejas: 5 min
POLL_TRAYS_MS=300000
# Contadores: 30 min
POLL_COUNTERS_MS=1800000
# Info de dispositivo: 24 h
POLL_DEVICE_INFO_MS=86400000
# Cadencia del temporizador base (opcional; por defecto = menor intervalo).
# Útil para pruebas manuales en modo mock con cadencias cortas, p.ej. 2000.
# POLL_TICK_MS=2000

# --- Seguridad (secciones 23-24) ---
# Secreto para firmar tokens de sesión (HMAC-SHA256). Cambiar en producción.
SESSION_SECRET=cambia-esto-en-produccion
# Vida útil del token de autenticación, en horas (default 8).
AUTH_TOKEN_TTL_HOURS=8
# Enforcement de autorización por roles. true = toda la API (salvo /api/health y
# /api/auth/*) exige token válido y el rol adecuado (Administrator/Technician/
# Viewer). Crea un admin con: npx tsx apps/server/src/cli/create-admin.ts <u> <p>
AUTH_ENFORCE=true
